{
  "name": "dnd-terrain-builder",
  "version": "1.0.3",
  "private": true,
  "description": "Offline tabletop terrain designer",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "package": "pnpm build && node scripts/package.cjs",
    "installer": "powershell -NoProfile -File scripts/release/build-launcher.ps1 && node scripts/release/wix.mjs && node scripts/release/launcher-msi.mjs",
    "generate:dungeon-range": "node scripts/plan-dungeon-range.mjs && node scripts/generate-dungeon-range.mjs --force",
    "generate:assets": "node scripts/generate-dungeon.mjs",
    "generate:expansions": "node scripts/generate-expansions.mjs",
    "generate:outdoor": "node scripts/generate-outdoor.mjs",
    "generate:openlock": "node scripts/generate-openlock.mjs",
    "generate:benchmarks": "node scripts/generate-benchmarks.mjs",
    "generate:connector": "node scripts/generate-foundry-link.mjs",
    "build:scenery": "node scripts/release/asset-packs.mjs",
    "generate:all": "node scripts/release/generate-all.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.4.3",
    "manifold-3d": "^3.5.3",
    "playwright": "1.63.0",
    "vite": "8.3.0"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MGN-Consultancy/TerrainFoundry.git"
  }
}
